TELEGRAM_BOT_TOKEN=123456:ABCdef...
TELEGRAM_SECRET_TOKEN=random_32_char_string_here
# Only these Telegram user ids may use the bot (comma separated). Empty = anyone.
# Find yours by messaging @userinfobot.
TELEGRAM_ALLOWED_USERS=
API_KEY=another_random_32_char_string
DATABASE_URL=./tasks.db
BASE_URL=https://your-oci-domain.com

# Spotify (Now Playing feature)
SPOTIFY_CLIENT_ID=...
SPOTIFY_CLIENT_SECRET=...
SPOTIFY_REFRESH_TOKEN=...

# Last.fm (Now Playing fallback for Spotify Free)
LASTFM_API_KEY=...
LASTFM_USER=...

# Weather for the room window (Open-Meteo, no key). Decimal degrees.
WEATHER_LAT=...
WEATHER_LON=...

# UniFlow: copy your "pendientes" to the panel (optional; the first three are needed).
# Supabase > Project Settings > API: project URL and the service_role key
# (secret: only here, never in the web app). User id: Authentication > Users.
UNIFLOW_SUPABASE_URL=
UNIFLOW_SERVICE_KEY=
UNIFLOW_USER_ID=
UNIFLOW_DAYS_AHEAD=7
UNIFLOW_SYNC_SECONDS=120
UNIFLOW_TZ=Europe/Madrid
